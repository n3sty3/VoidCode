<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>VoidCode</RootNamespace>
    <AssemblyName>VoidCode.Core</AssemblyName>
    <Version>1.1.1</Version>
    <Product>VoidCode Core</Product>
    <Company>VoidCode</Company>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Iced" Version="1.22.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Agent\**\*.cs" Link="Agent\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Bridge\**\*.cs" Link="Bridge\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Dap\**\*.cs" Link="Dap\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoidCode" />
    <InternalsVisibleTo Include="VoidCode.Mac" />
    <InternalsVisibleTo Include="VoidCode.Tests" />
  </ItemGroup>

  <!-- Private VoidAgent Core prompt: gitignored, embedded only when present (local dev or release CI secret).
       Public/open-source builds fall back to Prompts.PublicCoreDoctrine. -->
  <ItemGroup Condition="Exists('..\Agent\Private\voidagent-core.md')">
    <EmbeddedResource Include="..\Agent\Private\voidagent-core.md" LogicalName="VoidCode.Agent.CoreDoctrine.md" />
  </ItemGroup>

</Project>
