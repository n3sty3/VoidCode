{
  // FIX_PLAN T5.7: types without a rewrite. The frontend stays plain ES modules and classic scripts;
  // this config only *checks* them (noEmit) and the error count is ratcheted in scripts/baselines.json.
  // Scope grows the way the plan asks: wwwroot/core first (it is at zero and stays there), then
  // wwwroot/modules (ratchetted while it comes down), then the classic app.js.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    // Not strict on purpose: this step is about catching real mistakes in existing code (wrong
    // property, missing null check, a typo in a message name), not about rewriting it to satisfy
    // strictNullChecks. Tighten one flag at a time once the count is zero.
    "strict": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "wwwroot/types/**/*.d.ts",
    "wwwroot/core/**/*.js",
    "wwwroot/modules/**/*.js"
  ]
}